{
  "name": "roads",
  "version": "8.0.2",
  "author": {
    "name": "Aaron Hedges",
    "email": "aaron@dashron.com",
    "url": "http://www.dashron.com"
  },
  "description": "An isomorphic http framework",
  "keywords": [
    "http",
    "framework",
    "isomorphic"
  ],
  "homepage": "https://roadsjs.com",
  "scripts": {
    "test-types": "tsc --noEmit --project test/tsconfig.json",
    "test-code": "npm run test-types && node ./node_modules/.bin/vitest run ./test/__tests__",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc && node node_modules/eslint/bin/eslint.js",
    "test": "npm run lint && npm run test-code",
    "build": "tsc",
    "prepack": "tsc"
  },
  "bugs": {
    "url": "http://github.com/Dashron/roads/issues",
    "email": "aaron@dashron.com"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/Dashron/roads.git"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.11.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@types/url-parse": "^1.4.11",
    "content-type": "^3.1.1",
    "cookie": "^2.0.1",
    "fast-querystring": "^1.1.2",
    "url-parse": "^1.5.10"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.6.2",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "types"
  ],
  "type": "module"
}
