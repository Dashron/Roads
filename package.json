{
  "name": "roads",
  "version": "9.0.0-beta.1",
  "author": {
    "name": "Aaron Hedges",
    "email": "aaron@dashron.com",
    "url": "http://www.dashron.com"
  },
  "description": "An isomorphic http framework",
  "keywords": [
    "http",
    "framework",
    "isomorphic"
  ],
  "homepage": "https://roadsjs.com",
  "scripts": {
    "test-types": "tsc --noEmit --project test/tsconfig.json",
    "test-code": "node ./node_modules/.bin/vitest run ./test/__tests__",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit && npm run test-types && node node_modules/eslint/bin/eslint.js",
    "test": "npm run lint && npm run test-code",
    "clean": "node -e \"for (const target of ['dist', 'types', '.tsbuildinfo']) require('fs').rmSync(target, { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "prepack": "npm run build"
  },
  "bugs": {
    "url": "http://github.com/Dashron/roads/issues",
    "email": "aaron@dashron.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dashron/roads.git"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.11.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "content-type": "^3.1.1",
    "cookie": "^2.0.1"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "packageManager": "npm@11.6.2",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "types",
    "src"
  ],
  "type": "module"
}
